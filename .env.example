# ============================================================
# Cấu hình môi trường — PITECH LAB Dynamic Portfolio
# ============================================================
# Sao chép file này thành .env.local rồi điền giá trị thật:
#   cp .env.example .env.local
#
# LƯU Ý:
#  - Vite chỉ đọc biến môi trường LÚC BUILD, không phải lúc runtime.
#    Mỗi môi trường (dev/staging/prod) cần một lần build riêng.
#  - Chỉ biến có tiền tố "VITE_" mới được đưa ra phía trình duyệt.
#  - TUYỆT ĐỐI không đặt khoá bí mật thật vào biến VITE_* — chúng sẽ
#    bị nội tuyến trong bundle và ai cũng đọc được.
# ============================================================


# ------------------------------------------------------------
# URL gốc của backend REST API
# ------------------------------------------------------------
# Giá trị mặc định khi thiếu: http://localhost:8080
# Toàn bộ request REST sẽ gọi tới: {VITE_API_URL}/api/v1/...
VITE_API_URL=http://localhost:8080


# ------------------------------------------------------------
# URL của SockJS (STOMP over WebSocket) — dùng cho chat & gọi video
# ------------------------------------------------------------
# KHÔNG có giá trị mặc định — thiếu biến này sẽ gây lỗi ngay khi
# mở widget chat hoặc khởi động trang.
#
# Quy ước khuyến nghị: {VITE_WS_URL} phải trùng với {VITE_API_URL}/ws
#
# Lưu ý: pages/Home.tsx dùng {VITE_API_URL}/ws (tự nối "/ws"),
# còn các trang/component khác dùng biến này. Hai giá trị phải
# trỏ về CÙNG một endpoint SockJS.
VITE_WS_URL=http://localhost:8080/ws


# ------------------------------------------------------------
# Ghi chú cho từng môi trường
# ------------------------------------------------------------
#
# [Development]
#   VITE_API_URL=http://localhost:8080
#   VITE_WS_URL=http://localhost:8080/ws
#
# [Staging]
#   VITE_API_URL=https://api-staging.pitechlab.vn
#   VITE_WS_URL=https://api-staging.pitechlab.vn/ws
#
# [Production]
#   VITE_API_URL=https://api.pitechlab.vn
#   VITE_WS_URL=https://api.pitechlab.vn/ws
#
#
# ------------------------------------------------------------
# Gọi video WebRTC
# ------------------------------------------------------------
# Client hiện chỉ cấu hình STUN công cộng:
#   stun:stun.l.google.com:19302
# Điều này KHÔNG đủ khi hai bên cùng NAT ngăn chặn (mạng công ty,
# 4G, VPN). Cần bổ sung TURN server — xem tài liệu 03, mục 7.6.
#
# ------------------------------------------------------------
# Tài liệu tham khảo
# ------------------------------------------------------------
#   docs/03-HUONG-DAN-CAI-DAT-VA-SU-DUNG.md
#   docs/05-PHU-LUC-KY-THUAT.md
